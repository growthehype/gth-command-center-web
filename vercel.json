{
  "crons": [
    {
      "path": "/api/agent/cron/tick",
      "schedule": "0 16 * * 1-5"
    }
  ],
  "functions": {
    "api/agent/run.ts": {
      "maxDuration": 300,
      "includeFiles": "node_modules/@sparticuz/chromium/bin/**"
    },
    "api/agent/cron/tick.ts": {
      "maxDuration": 300,
      "includeFiles": "node_modules/@sparticuz/chromium/bin/**"
    },
    "api/agent/cron/hunt.ts": {
      "maxDuration": 300,
      "includeFiles": "node_modules/@sparticuz/chromium/bin/**"
    },
    "api/agent/preview.ts": {
      "maxDuration": 300,
      "includeFiles": "{node_modules/@sparticuz/chromium/bin/**,concepts/**}"
    }
  }
}