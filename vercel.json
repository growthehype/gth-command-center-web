{
  "crons": [
    {
      "path": "/api/agent/cron/tick",
      "schedule": "0 16 * * 1-5"
    }
  ],
  "functions": {
    "api/agent/run.ts": {
      "maxDuration": 300
    },
    "api/agent/cron/tick.ts": {
      "maxDuration": 300
    },
    "api/agent/cron/hunt.ts": {
      "maxDuration": 300
    },
    "api/agent/preview.ts": {
      "maxDuration": 300,
      "includeFiles": "concepts/**"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), geolocation=(), payment=()"
        }
      ]
    }
  ]
}
