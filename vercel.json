{
  "crons": [
    {
      "path": "/api/agent/cron/tick",
      "schedule": "0 16 * * 1-5"
    }
  ],
  "functions": {
    "api/agent/run.ts": {
      "maxDuration": 300
    },
    "api/agent/cron/tick.ts": {
      "maxDuration": 300
    },
    "api/agent/cron/hunt.ts": {
      "maxDuration": 300
    },
    "api/agent/preview.ts": {
      "maxDuration": 300,
      "includeFiles": "concepts/**"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), geolocation=(), payment=()"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/.well-known/oauth-authorization-server/:path*",
      "destination": "/api/oauth?op=as"
    },
    {
      "source": "/.well-known/oauth-authorization-server",
      "destination": "/api/oauth?op=as"
    },
    {
      "source": "/.well-known/oauth-protected-resource/:path*",
      "destination": "/api/oauth?op=resource"
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "/api/oauth?op=resource"
    },
    {
      "source": "/api/oauth/:op",
      "destination": "/api/oauth?op=:op"
    }
  ]
}
